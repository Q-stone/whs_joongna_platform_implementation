# uploads/ - 웹셸 원천 차단 (Apache .htaccess 레벨 2차 방어)
# vhost에서 php_admin_flag engine off 가 이미 적용됨; 여기서는 추가 보호.
php_flag engine off
Options -ExecCGI -Indexes
AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .pht .phar .inc
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pht|phar|inc)$">
    Require all denied
</FilesMatch>
ForceType application/octet-stream