# 나무장터 환경변수 (IaC)
# 사용: cp .env.example .env → 값 변경 → docker compose up -d

# MariaDB
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT_PW
MARIADB_DATABASE=joongna
MARIADB_USER=joongna
MARIADB_PASSWORD=CHANGE_ME_DB_PW
DB_HOST=mariadb
DB_NAME=joongna
DB_USER=joongna
DB_PASS=CHANGE_ME_DB_PW

# 비밀번호 솔트 (SHA-256, 16자 이상 권장)
PW_SALT_PRE=CHANGE_ME_SALT_PRE
PW_SALT_POST=CHANGE_ME_SALT_POST

# 플랫폼 포트
APP_PORT=8082